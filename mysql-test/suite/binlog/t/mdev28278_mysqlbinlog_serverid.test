# MDEV-28278
# regression test for MDEV-28278
# ensure visibility in PR

--source include/have_log_bin.inc
--source include/have_binlog_format_statement.inc
--source include/master-slave.inc

connection master;

CREATE TABLE t1 (id INT);
INSERT INTO t1 VALUES (1),(2),(3);

FLUSH LOGS;
INSERT INTO t1 VALUES (10);

--replace_regex /^SET TIMESTAMP=.*$//
--exec $MYSQL_TEST_DIR/../client/mariadb-binlog --base64-output=DECODE-ROWS --short-form $MYSQLTEST_VARDIR/mysqld.1/data/master-bin.000001

connection master;
DROP TABLE IF EXISTS t1;

connection slave;
STOP SLAVE;
RESET SLAVE ALL;
DROP TABLE IF EXISTS t1;
